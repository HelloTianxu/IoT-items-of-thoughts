{
  "name": "dsh-plugin-iot-thinking",
  "version": "0.3.0",
  "description": "IoT (Items of Thoughts) for DeepSeek Harness: rewrite the reasoning block inside llm/stream before the assistant message is committed — decision-node compression per session / agent preset, offloadable to a cheaper route, plus an optional outside-observer advice layer ([旁观者建议]) that can run builtin or as a concurrent external model. No compaction checkpoint.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "thinking",
    "reasoning",
    "iot"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node selftest.mjs && node smoke.mjs",
    "test:teacher": "node --experimental-vm-modules teacher-entry-test.mjs",
    "smoke": "node smoke.mjs"
  }
}
