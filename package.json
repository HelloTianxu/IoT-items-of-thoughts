{
  "name": "dsh-plugin-iot-thinking",
  "version": "0.3.0",
  "description": "IoT (Items of Thoughts) for DeepSeek Harness: rewrite reasoning blocks before assistant commit, with per-session/preset compression, optional advisor and teacher consultation, plus durable session archive and memory tools. No compaction checkpoint.",
  "type": "module",
  "main": "dsh-plugin-iot-thinking/index.mjs",
  "exports": {
    ".": "./dsh-plugin-iot-thinking/index.mjs",
    "./client": "./dsh-plugin-iot-thinking/lib/client.js",
    "./package.json": "./dsh-plugin-iot-thinking/package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin-iot-thinking/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dsh-plugin-iot-thinking/index.mjs",
    "dsh-plugin-iot-thinking/lib/",
    "dsh-plugin-iot-thinking/skills/",
    "dsh-plugin-iot-thinking/cordis.patch.yml",
    "dsh-plugin-iot-thinking/package.json",
    "dsh-plugin-iot-thinking/README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roninton/IoT-items-of-thoughts.git"
  },
  "scripts": {
    "test": "npm --prefix dsh-plugin-iot-thinking test",
    "test:archive": "npm --prefix dsh-plugin-iot-thinking run test:archive",
    "test:teacher": "npm --prefix dsh-plugin-iot-thinking run test:teacher",
    "smoke": "npm --prefix dsh-plugin-iot-thinking run smoke",
    "check:manifests": "node scripts/check-manifests.mjs"
  }
}
